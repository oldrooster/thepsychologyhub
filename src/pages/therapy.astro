---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page = pages.find(p => p.id === 'therapy')!;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} heroImage={page.data.heroImage} description="Evidence-based therapy for individuals of all ages at The Psychology Hub in Riccarton, Christchurch.">
  <Content />
</PageLayout>
