---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page = pages.find(p => p.id === 'fees')!;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} heroImage={page.data.heroImage} description="Information about fees, ACC funding, and insurance at The Psychology Hub, Christchurch.">
  <Content />
</PageLayout>
