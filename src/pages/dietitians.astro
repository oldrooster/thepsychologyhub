---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page = pages.find(p => p.id === 'dietitians')!;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} heroImage={page.data.heroImage} description="Registered Dietitian services at The Psychology Hub, specialising in eating disorders and nutrition support.">
  <Content />
</PageLayout>
