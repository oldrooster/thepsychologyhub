---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page = pages.find(p => p.id === 'room-rental')!;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} heroImage={page.data.heroImage} description="Professional room rental for clinicians at The Psychology Hub, Riccarton, Christchurch.">
  <Content />
</PageLayout>
