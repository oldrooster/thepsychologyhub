---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page = pages.find(p => p.id === 'assessment')!;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} heroImage={page.data.heroImage} description="Psychological assessments at The Psychology Hub, including ACC mental injury assessments and neurodevelopmental assessments.">
  <Content />
</PageLayout>
