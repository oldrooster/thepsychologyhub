---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="static-page">
    <div class={`page-hero${heroImage ? ' has-image' : ''}`}>
      {heroImage && (
        <img
          src={heroImage}
          alt=""
          class="page-hero-image"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      )}
      <div class="container">
        <h1 class="page-title">{title}</h1>
      </div>
    </div>
    <div class="page-body">
      <div class="container">
        <div class="prose page-prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: var(--color-warm-white);
    min-height: 190px;
    border-bottom: 1px solid var(--color-border-light);
    display: flex;
    align-items: center;
  }

  .page-hero.has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(16, 24, 32, 0.08), rgba(16, 24, 32, 0.2));
    pointer-events: none;
  }

  .page-hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: center;
  }

  .page-hero.has-image .container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: clamp(0.75rem, 2.6vw, 1.6rem);
    padding-top: 0;
  }

  .page-title {
    font-size: clamp(1.1rem, 2.1vw, 1.3rem);
    font-weight: 700;
    color: #ffffff;
    background: rgba(129, 162, 63, 0.9);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 2px;
    padding: 0.5rem 1.4rem;
  }

  .page-body {
    padding: 3rem 0 5rem;
  }

  .page-prose {
    width: 100%;
    max-width: none;
  }

  .page-prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-sage-dark);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-sage-bg);
  }

  .page-prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .page-prose :global(p) {
    margin-bottom: 1.1rem;
    color: var(--color-text);
    line-height: 1.75;
  }

  .page-prose :global(ul),
  .page-prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }

  .page-prose :global(li) {
    margin-bottom: 0.45rem;
    line-height: 1.65;
  }

  .page-prose :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .page-prose :global(a) {
    color: var(--color-sage-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-sage-light);
    text-underline-offset: 3px;
  }

  .page-prose :global(a:hover) {
    color: var(--color-green-available);
  }

  .page-prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin: 1.5rem 0;
    display: block;
  }

  .page-prose :global(.proverb) {
    border-left: 4px solid var(--color-sage);
    padding: 1.25rem 1.75rem;
    margin: 2rem 0;
    background: var(--color-sage-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .page-prose :global(.proverb__reo) {
    font-size: 1.2rem;
    font-style: italic;
    font-weight: 600;
    color: var(--color-sage-dark);
    margin-bottom: 0.5rem;
  }

  .page-prose :global(.proverb__translation) {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .page-prose :global(figure) {
    margin: 0;
  }

  .page-prose :global(figcaption) {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-align: center;
    padding: 0.5rem 0.25rem 0;
    font-style: italic;
  }

  .page-prose :global(.two-col) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin: 0;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .page-prose :global(.two-col:last-child) {
    border-bottom: none;
  }

  .page-prose :global(.two-col__img img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin: 0;
    display: block;
  }

  .page-prose :global(.two-col--img-right .two-col__img) {
    order: 2;
  }

  .page-prose :global(.two-col--img-right .two-col__text) {
    order: 1;
  }

  .page-prose :global(.two-col h2) {
    margin-top: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .page-prose :global(.two-col p) {
    margin-bottom: 0.75rem;
  }

  .page-prose :global(.two-col p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .page-prose :global(.two-col) {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .page-prose :global(.two-col--img-right .two-col__img) {
      order: -1;
    }
  }

  .page-prose :global(.room-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .page-prose :global(.room-card) {
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    overflow: hidden;
    background: white;
  }

  .page-prose :global(.room-card img) {
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 0;
    display: block;
  }

  .page-prose :global(.room-card p) {
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1rem;
      padding: 0.45rem 1rem;
    }

    .page-hero {
      min-height: 150px;
    }

    .page-hero .container {
      padding: 0.85rem 1rem;
    }

    .page-body {
      padding: 2rem 0 3rem;
    }
  }
</style>
